package web

import (
	"fmt"
	"strings"

	"github.com/cattyman919/autocv/internal/core/domain"
)

templ EditorPage(typeName string, typeNames []string, general *domain.CVGeneral, settings *domain.CVSettings, cvType *domain.CVType, typstAvailable bool, envFields map[string]string) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>AutoCV — { cvType.TypeName }</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					darkMode: 'class',
					theme: {
						extend: {
							fontFamily: {
								sans: ['Inter', 'system-ui', 'sans-serif'],
							},
						},
					},
				}
			</script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
			<script src="/static/app.js"></script>
			<script src="/static/editor.js"></script>
			<script src="/static/split-panel.js"></script>
		</head>
		<body class="h-screen flex flex-col overflow-hidden" data-current-type={ typeName }
			style="background-color: var(--color-background); color: var(--color-foreground);">
			<header class="shrink-0 flex items-center justify-between px-4 py-2"
				style="background-color: var(--color-surface); border-bottom: 1px solid var(--color-border);">
				<div class="flex items-center gap-3">
					<h1 class="text-lg font-bold" style="color: var(--color-foreground);">AutoCV</h1>
					@CVTypeSelector(typeName, typeNames)
				</div>
				<div class="flex items-center gap-2">
					<button id="btn-theme-toggle" class="icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode">
						@IconSun()
						@IconMoon()
					</button>
					if typstAvailable {
						<button class="btn btn-primary" id="btn-generate-pdf">
							@IconPlay()
							Generate
						</button>
					}
					if !typstAvailable {
						<span class="text-xs px-2 py-1 rounded"
							style="background: var(--color-badge-shared-bg); color: var(--color-badge-shared-text);">
							Typst not installed
						</span>
					}
					<button class="btn btn-ghost" id="btn-create-cv">
						@IconPlus()
						New CV
					</button>
				</div>
			</header>

			<div id="mobile-tabs">
				<button class="mobile-tab active" data-tab="editor">Editor</button>
				<button class="mobile-tab" data-tab="preview">Preview</button>
			</div>

			<main id="main-layout" class="flex flex-1 overflow-hidden">
				<div id="editor-panel" class="overflow-y-auto p-4"
					style="background-color: var(--color-surface);">
					@EditorPanel(typeName, general, settings, cvType, envFields)
				</div>

				<div id="pdf-panel" class="flex flex-col" style="background-color: var(--color-background);">
					<div id="pdf-status" class="pdf-status-bar">
						<span id="pdf-status-icon">
							<svg width="8" height="8" viewBox="0 0 8 8"><circle class="status-dot" cx="4" cy="4" r="4" fill="#94A3B8"/></svg>
						</span>
						<span id="pdf-status-text">Idle</span>
					</div>
					<div id="pdf-error" class="hidden pdf-error-bar"></div>
					<div id="pdf-viewer" class="pdf-viewer">
						if typstAvailable {
							<div id="pdf-pages-container" class="pdf-pages-container"></div>
						} else {
							<div class="flex items-center justify-center h-full" style="color: var(--color-muted-foreground);">
								<p>Install Typst to enable PDF preview</p>
							</div>
						}
					</div>
					if typstAvailable {
						<div class="pdf-controls">
							<button id="btn-zoom-out" title="Zoom out" aria-label="Zoom out">
								@IconMinus()
							</button>
							<span id="zoom-display" class="zoom-display">100%</span>
							<button id="btn-zoom-in" title="Zoom in" aria-label="Zoom in">
								@IconPlus()
							</button>
							<button id="btn-zoom-fit" title="Fit to width" aria-label="Fit to width">
								@IconMaximize()
							</button>
							<span id="page-info" class="page-info"></span>
						</div>
					}
				</div>
			</main>

			<div id="create-cv-dialog" class="hidden">
				<div class="modal-backdrop">
					<div class="modal-content">
						<h3 class="text-lg font-bold mb-4" style="color: var(--color-foreground);">Create New CV Type</h3>
						<div class="mb-3">
							<label class="form-label" for="new-cv-name">Name</label>
							<input id="new-cv-name" type="text" class="form-input" placeholder="e.g. backend_v2"/>
						</div>
						<div class="mb-4">
							<label class="form-label" for="new-cv-clone">Clone from</label>
							<select id="new-cv-clone" class="form-input">
								<option value="">Blank</option>
								for _, name := range typeNames {
									<option value={ name }>{ name }</option>
								}
							</select>
						</div>
						<div class="flex justify-end gap-2">
							<button class="btn btn-ghost" id="btn-create-cancel">Cancel</button>
							<button class="btn btn-primary"
								hx-post="/api/cv-type/create"
								hx-vals='js:{type_name: document.getElementById("new-cv-name").value, clone_from: document.getElementById("new-cv-clone").value}'
								hx-target="#cv-type-selector"
								hx-swap="outerHTML"
								id="btn-create-confirm">Create</button>
						</div>
					</div>
				</div>
			</div>

			<div id="rename-cv-dialog" class="hidden">
				<div class="modal-backdrop">
					<div class="modal-content">
						<h3 class="text-lg font-bold mb-4" style="color: var(--color-foreground);">Rename CV Type</h3>
						<input type="hidden" id="rename-cv-old" value={ typeName }/>
						<div class="mb-4">
							<label class="form-label" for="rename-cv-new">New Name</label>
							<input id="rename-cv-new" type="text" class="form-input" value={ typeName }/>
						</div>
						<div class="flex justify-end gap-2">
							<button class="btn btn-ghost" id="btn-rename-cancel">Cancel</button>
							<button class="btn btn-primary"
								hx-post="/api/cv-type/rename"
								hx-vals='js:{old_name: document.getElementById("rename-cv-old").value, new_name: document.getElementById("rename-cv-new").value}'
								hx-target="#cv-type-selector"
								hx-swap="outerHTML"
								id="btn-rename-confirm">Rename</button>
						</div>
					</div>
				</div>
			</div>

			<div id="delete-cv-dialog" class="hidden">
				<div class="modal-backdrop">
					<div class="modal-content">
						<h3 class="text-lg font-bold mb-4" style="color: var(--color-foreground);">Delete CV Type</h3>
						<p class="text-sm mb-4" style="color: var(--color-muted-foreground);">Are you sure you want to delete <strong id="delete-cv-name" style="color: var(--color-foreground);"></strong>? This cannot be undone.</p>
						<div class="flex justify-end gap-2">
							<button class="btn btn-ghost" id="btn-delete-cancel">Cancel</button>
							<button id="delete-cv-confirm" class="btn btn-destructive"
								hx-post="/api/cv-type/delete"
								hx-target="#cv-type-selector"
								hx-swap="outerHTML">Delete</button>
						</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ CVTypeSelector(typeName string, typeNames []string) {
	<div id="cv-type-selector" class="flex items-center gap-2">
		<select id="cv-type-dropdown" class="form-input" style="width: auto; padding: 4px 8px; font-size: var(--font-size-label);"
			onchange="window.location.href='/cv/'+this.value">
			for _, name := range typeNames {
				if name == typeName {
					<option value={ name } selected>{ name }</option>
				} else {
					<option value={ name }>{ name }</option>
				}
			}
		</select>
		<button class="icon-btn" id="btn-rename-cv" title="Rename" aria-label="Rename CV type">
			@IconPencil()
		</button>
		<button class="icon-btn icon-btn--destructive" id="btn-delete-cv" title="Delete" aria-label="Delete CV type">
			@IconX()
		</button>
	</div>
}

templ EditorPanel(typeName string, general *domain.CVGeneral, settings *domain.CVSettings, cvType *domain.CVType, envFields map[string]string) {
	<div class="space-y-2">
		@LayoutSection(typeName, cvType.Layouts)
		@PersonalInfoSection(general, envFields)
		@SettingsSection(settings)
		@DescriptionSection(typeName, cvType.Description)
		@ExperiencesSection(typeName, cvType.Experiences)
		@ProjectsSection(typeName, cvType.Projects)
		@SkillsSection(general.Skills)
		@EducationSection(general.Educations)
		@CertificatesSection(general.Certifications)
		@AwardsSection(general.Awards)
	</div>
}

templ LayoutSection(typeName string, layouts []domain.Layout) {
	<div class="section-card">
		<button class="section-header" data-accordion="layout-section" data-state="open">
			<div class="flex items-center gap-2 flex-1">
				@IconLayout()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Layout Order</span>
				<span class="section-badge section-badge--type">Type</span>
			</div>
			<span id="layout-section-icon" class="accordion-icon" data-state="open">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="layout-section" class="accordion-content open">
			<div class="section-content">
				<div class="sortable-list space-y-1" data-type-name={ typeName }>
					for i, layout := range layouts {
						<div class="flex items-center gap-2 rounded-md px-3 py-2 text-sm"
							style="background: var(--color-muted); border: 1px solid var(--color-border);"
							data-layout={ string(layout) }>
							<span class="drag-handle" style="color: var(--color-muted-foreground); cursor: grab;">
								@IconGripVertical()
							</span>
							<span style="color: var(--color-foreground);">{ string(layout) }</span>
							<span class="ml-auto text-xs" style="color: var(--color-muted-foreground);">#{ fmt.Sprintf("%d", i+1) }</span>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ PersonalInfoSection(general *domain.CVGeneral, envFields map[string]string) {
	<div class="section-card">
		<button class="section-header" data-accordion="personal-info-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconUser()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Personal Info</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="personal-info-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="personal-info-section" class="accordion-content">
			@PersonalInfoForm(general, envFields)
		</div>
	</div>
}

templ PersonalInfoForm(general *domain.CVGeneral, envFields map[string]string) {
	<form class="section-content space-y-2"
		hx-post="/api/personal-info"
		hx-trigger="change, keyup changed delay:500ms from:input"
		hx-target="#personal-info-section"
		hx-swap="innerHTML">
		@inputField("name", "Name", general.PersonalInfo.Name, "")
		@inputField("email", "Email", general.PersonalInfo.Email, "")
		@envInputField("phone", "Phone", general.PersonalInfo.Phone, envFields)
		@inputField("website", "Website", general.PersonalInfo.Website, "")
		@inputField("linkedin", "LinkedIn", general.PersonalInfo.Linkedin, "")
		@inputField("linkedin_handle", "LinkedIn Handle", general.PersonalInfo.LinkedinHandle, "")
		@inputField("github", "GitHub", general.PersonalInfo.Github, "")
		@inputField("github_handle", "GitHub Handle", general.PersonalInfo.GithubHandle, "")
		@inputField("profile_pic", "Profile Picture", general.PersonalInfo.ProfilePic, "")
		@inputField("location", "Location", general.PersonalInfo.Location, "")
	</form>
}

templ SettingsSection(settings *domain.CVSettings) {
	<div class="section-card">
		<button class="section-header" data-accordion="settings-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconSettings()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Settings</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="settings-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="settings-section" class="accordion-content">
			@SettingsForm(settings)
		</div>
	</div>
}

templ SettingsForm(settings *domain.CVSettings) {
	<form class="section-content space-y-2"
		hx-post="/api/settings"
		hx-trigger="change, keyup changed delay:500ms from:input"
		hx-target="#settings-section"
		hx-swap="innerHTML">
		@inputField("font", "Font", settings.Font, "")
		@inputField("accent_color", "Accent Color", settings.AccentColor, "")
	</form>
}

templ DescriptionSection(typeName string, description string) {
	<div class="section-card">
		<button class="section-header" data-accordion={ "description-section-" + typeName } data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconFileText()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Description</span>
				<span class="section-badge section-badge--type">Type</span>
			</div>
			<span id={ "description-section-" + typeName + "-icon" } class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id={ "description-section-" + typeName } class="accordion-content">
			<form class="section-content"
				hx-post={ "/api/description/" + typeName }
				hx-trigger="change, keyup changed delay:500ms from:textarea"
				hx-swap="none">
				<textarea name="description" class="form-input" style="height: 6rem;">{ description }</textarea>
			</form>
		</div>
	</div>
}

templ ExperiencesSection(typeName string, experiences []domain.Experience) {
	<div class="section-card">
		<button class="section-header" data-accordion={ "experiences-section-" + typeName } data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconBriefcase()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Experiences ({ fmt.Sprintf("%d", len(experiences)) })</span>
				<span class="section-badge section-badge--type">Type</span>
			</div>
			<span id={ "experiences-section-" + typeName + "-icon" } class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id={ "experiences-section-" + typeName } class="accordion-content">
			<div class="section-content space-y-2">
				for i, exp := range experiences {
					@ExperienceEntry(typeName, i, exp)
				}
				<button class="btn btn-ghost text-xs"
					hx-post={ "/api/experience/" + typeName + "/add" }
					hx-target={ "#experiences-section-" + typeName }
					hx-swap="innerHTML">
					@IconPlus()
					Add Experience
				</button>
			</div>
		</div>
	</div>
}

templ ExperienceEntry(typeName string, index int, exp domain.Experience) {
	<div class="rounded-lg p-3" style="background: var(--color-muted); border: 1px solid var(--color-border);">
		<div class="flex items-center justify-between mb-2">
			<button class="text-sm font-medium flex items-center gap-1" style="color: var(--color-foreground);" data-accordion={ fmt.Sprintf("exp-%s-%d", typeName, index) }>
				<span id={ fmt.Sprintf("exp-%s-%d-icon", typeName, index) } class="accordion-icon" data-state="closed" style="padding: 2px;">
					@IconChevronDown()
					@IconChevronRight()
				</span>
				{ exp.Role } { expCompanyLabel(exp) }
			</button>
			<button class="btn btn-ghost text-xs icon-btn--destructive"
				hx-post={ fmt.Sprintf("/api/experience/%s/%d/delete", typeName, index) }
				hx-target={ fmt.Sprintf("#experiences-section-%s", typeName) }
				hx-swap="innerHTML">
				@IconTrash()
			</button>
		</div>
		<div id={ fmt.Sprintf("exp-%s-%d", typeName, index) } class="accordion-content">
			<form class="space-y-2"
				hx-post={ fmt.Sprintf("/api/experience/%s/%d", typeName, index) }
				hx-trigger="change, keyup changed delay:500ms from:input, from:textarea"
				hx-swap="none">
				<div class="grid grid-cols-2 gap-2">
					@inputField("role", "Role", exp.Role, "")
					@inputField("company", "Company", exp.Company, "")
					@inputField("job_type", "Job Type", exp.JobType, "")
					@inputField("location", "Location", exp.Location, "")
				</div>
				@inputField("dates", "Dates", exp.Dates, "")
				<div>
					<label class="form-label">Points (one per line)</label>
					<textarea name="points" class="form-input" style="height: 8rem;">{ strings.Join(exp.Points, "\n") }</textarea>
				</div>
			</form>
		</div>
	</div>
}

templ ProjectsSection(typeName string, projects []domain.Project) {
	<div class="section-card">
		<button class="section-header" data-accordion={ "projects-section-" + typeName } data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconCode()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Projects ({ fmt.Sprintf("%d", len(projects)) })</span>
				<span class="section-badge section-badge--type">Type</span>
			</div>
			<span id={ "projects-section-" + typeName + "-icon" } class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id={ "projects-section-" + typeName } class="accordion-content">
			<div class="section-content space-y-2">
				for i, proj := range projects {
					@ProjectEntry(typeName, i, proj)
				}
				<button class="btn btn-ghost text-xs"
					hx-post={ "/api/project/" + typeName + "/add" }
					hx-target={ "#projects-section-" + typeName }
					hx-swap="innerHTML">
					@IconPlus()
					Add Project
				</button>
			</div>
		</div>
	</div>
}

templ ProjectEntry(typeName string, index int, proj domain.Project) {
	<div class="rounded-lg p-3" style="background: var(--color-muted); border: 1px solid var(--color-border);">
		<div class="flex items-center justify-between mb-2">
			<button class="text-sm font-medium flex items-center gap-1" style="color: var(--color-foreground);" data-accordion={ fmt.Sprintf("proj-%s-%d", typeName, index) }>
				<span id={ fmt.Sprintf("proj-%s-%d-icon", typeName, index) } class="accordion-icon" data-state="closed" style="padding: 2px;">
					@IconChevronDown()
					@IconChevronRight()
				</span>
				{ proj.Name }
			</button>
			<button class="btn btn-ghost text-xs icon-btn--destructive"
				hx-post={ fmt.Sprintf("/api/project/%s/%d/delete", typeName, index) }
				hx-target={ fmt.Sprintf("#projects-section-%s", typeName) }
				hx-swap="innerHTML">
				@IconTrash()
			</button>
		</div>
		<div id={ fmt.Sprintf("proj-%s-%d", typeName, index) } class="accordion-content">
			<form class="space-y-2"
				hx-post={ fmt.Sprintf("/api/project/%s/%d", typeName, index) }
				hx-trigger="change, keyup changed delay:500ms from:input, from:textarea"
				hx-swap="none">
				<div class="grid grid-cols-2 gap-2">
					@inputField("name", "Name", proj.Name, "")
					@inputField("github", "GitHub URL", proj.Github, "")
				</div>
				@inputField("github_handle", "GitHub Handle", proj.GithubHandle, "")
				<div>
					<label class="form-label">Points (one per line)</label>
					<textarea name="points" class="form-input" style="height: 8rem;">{ strings.Join(proj.Points, "\n") }</textarea>
				</div>
			</form>
		</div>
	</div>
}

templ SkillsSection(skills []domain.SkillGroup) {
	<div class="section-card">
		<button class="section-header" data-accordion="skills-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconStar()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Skills</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="skills-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="skills-section" class="accordion-content">
			<div class="section-content space-y-3">
				for _, sg := range skills {
					<div>
						<div class="form-label mb-1">{ sg.Title }</div>
						<div class="text-sm" style="color: var(--color-foreground);">{ strings.Join(sg.Items, ", ") }</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ EducationSection(educations []domain.Education) {
	<div class="section-card">
		<button class="section-header" data-accordion="education-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconGraduationCap()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Education</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="education-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="education-section" class="accordion-content">
			<div class="section-content space-y-2">
				for _, edu := range educations {
					<div class="rounded-lg p-3" style="background: var(--color-muted); border: 1px solid var(--color-border);">
						<div class="text-sm font-medium" style="color: var(--color-foreground);">{ edu.Institution }</div>
						<div class="text-xs" style="color: var(--color-muted-foreground);">{ edu.Degree } &middot; { edu.Dates }</div>
						<div class="text-xs" style="color: var(--color-muted-foreground);">GPA: { edu.Gpa }</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ CertificatesSection(certs []domain.Certificate) {
	<div class="section-card">
		<button class="section-header" data-accordion="certificates-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconAward()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Certificates</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="certificates-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="certificates-section" class="accordion-content">
			<div class="section-content space-y-1">
				for _, cert := range certs {
					<div class="text-sm" style="color: var(--color-foreground);">{ cert.Name } <span class="text-xs" style="color: var(--color-muted-foreground);">({ cert.Year })</span></div>
				}
			</div>
		</div>
	</div>
}

templ AwardsSection(awards []domain.Award) {
	<div class="section-card">
		<button class="section-header" data-accordion="awards-section" data-state="closed">
			<div class="flex items-center gap-2 flex-1">
				@IconTrophy()
				<span class="font-medium text-sm" style="color: var(--color-foreground);">Awards</span>
				<span class="section-badge section-badge--shared">Shared</span>
			</div>
			<span id="awards-section-icon" class="accordion-icon" data-state="closed">
				@IconChevronDown()
				@IconChevronRight()
			</span>
		</button>
		<div id="awards-section" class="accordion-content">
			<div class="section-content space-y-2">
				for _, award := range awards {
					<div class="rounded-lg p-3" style="background: var(--color-muted); border: 1px solid var(--color-border);">
						<div class="text-sm font-medium" style="color: var(--color-foreground);">{ award.Title }</div>
						<div class="text-xs" style="color: var(--color-muted-foreground);">{ award.Organization } &middot; { award.Date }</div>
						for _, point := range award.Points {
							<div class="text-xs mt-1 pl-2" style="color: var(--color-muted-foreground); border-left: 2px solid var(--color-border);">{ point }</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
}

templ inputField(name string, label string, value string, placeholder string) {
	<div class="flex flex-col space-y-0.5">
		<label class="form-label">{ label }</label>
		<input type="text" name={ name } value={ value } placeholder={ placeholder } class="form-input"/>
	</div>
}

templ envInputField(name string, label string, value string, envFields map[string]string) {
	<div class="flex flex-col space-y-0.5">
		<div class="flex items-center gap-2">
			<label class="form-label">{ label }</label>
			if isEnvField(value, envFields) {
				<span class="env-badge" title={ fmt.Sprintf("Uses env var: %s", getEnvVarName(value, envFields)) }>
					@IconLock()
					ENV: { getEnvVarName(value, envFields) }
				</span>
			}
		</div>
		<input type="text" id={ "field-" + name } name={ name } value={ value } class="form-input"/>
		if isEnvField(value, envFields) {
			<span id={ "field-" + name + "-toggle" } class="env-toggle"
				data-env-toggle={ "field-" + name }
				data-env-var={ getEnvVarName(value, envFields) }
				data-env-resolved={ value }>Show env template</span>
		}
	</div>
}

