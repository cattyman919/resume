func isEnvField(value string, envFields map[string]string) bool {
	for raw := range envFields {
		if strings.Contains(value, raw) || value == raw {
			return true
		}
	}
	return strings.Contains(value, "{"+"{ env ")
}

func getEnvVarName(value string, envFields map[string]string) string {
	for raw, varName := range envFields {
		if strings.Contains(value, raw) || value == raw {
			return varName
		}
	}
	return ""
}

func expCompanyLabel(exp domain.Experience) string {
	if exp.Company != "" {
		return "at " + exp.Company
	}
	return ""
}
